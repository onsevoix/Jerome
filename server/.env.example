# Copiez ce fichier en ".env" et remplissez vos vraies valeurs.
# Sans ce fichier, le serveur fonctionne quand même en "mode simulation"
# (les envois sont loggés dans la console mais pas réellement envoyés à Airtable).

# Personal Access Token Airtable (scopes data.records:read + data.records:write
# sur la base ci-dessous). À créer sur https://airtable.com/create/tokens
AIRTABLE_API_KEY=

# Identifiant de la base Airtable (visible dans l'URL de la base, commence par "app")
AIRTABLE_BASE_ID=app4NkWPJfMncobQO

# Noms exacts des tables Airtable à utiliser
AIRTABLE_DECLA_TABLE=Declas
AIRTABLE_PARTICIPATION_TABLE=Participations

# Nom exact du champ "Célibataire" (liste déroulante à choix unique) dans la table
# décla ci-dessus — utilisé pour afficher la liste à jour dans le formulaire.
# Nécessite le scope schema.bases:read sur le token Airtable.
AIRTABLE_CELIBATAIRE_FIELD=Célibataire

# Port du serveur (optionnel)
PORT=3001
